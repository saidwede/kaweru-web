# ---------------------------------------------------------------------------
# Kaweru Web — le backend est sur Firebase (Cloud Functions + Firestore + Auth).
# Plus aucun secret serveur ici : ils sont dans Cloud Secret Manager
# (voir functions/.env.example et docs/adr/0002-migration-firebase.md).
# ---------------------------------------------------------------------------

# URL de la Cloud Function `api` vers laquelle Next.js relaie /api/*
KAWERU_API_ORIGIN=https://europe-west1-kaweru-app.cloudfunctions.net/api
# En local avec l'émulateur :
# KAWERU_API_ORIGIN=http://127.0.0.1:5001/kaweru-app/europe-west1/api

# Firebase Web Client (valeurs publiques par nature : Console Firebase > Paramètres du projet)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kaweru-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kaweru-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kaweru-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
