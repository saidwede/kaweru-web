# Base de données MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kaweru?retryWrites=true&w=majority

# Firebase Admin SDK (Serveur privé - Ne JAMAIS exposer côté client)
FIREBASE_PROJECT_ID=kaweru-app
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Firebase Web Client (Public - Accessible dans le navigateur pour OTP SMS)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Paiement Mobile Money (Fedapay)
FEDAPAY_SECRET_KEY=sk_live_...
FEDAPAY_PUBLIC_KEY=pk_live_...
# sandbox | live (détermine l'API utilisée pour revérifier les transactions)
FEDAPAY_ENVIRONMENT=sandbox

# Service Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_FROM="Kaweru" <no-reply@kaweru.com>

# ---------------------------------------------------------------------------
# SÉCURITÉ — OBLIGATOIRES EN PRODUCTION (l'application refuse de démarrer les
# routes concernées sans elles). Générer chaque valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
# Signature des sessions (cookie web + jeton Bearer mobile). Min. 32 caractères.
# La changer déconnecte tout le monde.
SESSION_SECRET=
# Signature HMAC des QR codes des billets. Min. 32 caractères.
QR_SECRET_KEY=
# Secret du webhook FedaPay (Tableau de bord FedaPay > Webhooks). Sans lui, le webhook répond 503.
FEDAPAY_WEBHOOK_SECRET=

# Renvoyer le code OTP à l'écran quand aucun SMS/e-mail n'a pu être envoyé.
# NE JAMAIS activer en production réelle : n'importe qui pourrait se connecter sur n'importe quel numéro.
# Réservé à une phase pilote fermée tant que la passerelle SMS n'est pas branchée.
OTP_INSECURE_FALLBACK=false

# Liste des emails Super Admin (séparés par des virgules)
SUPER_ADMIN_EMAILS=contact@kaweru.bj,admin@kaweru.bj

# URL publique de l'application
NEXT_PUBLIC_APP_URL=https://kaweru-reactiver.vercel.app/ut

